{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "color": {
      "palette": [
        {
          "name": "Primary",
          "slug": "primary",
          "color": "#0073aa"
        },
        {
          "name": "Secondary",
          "slug": "secondary",
          "color": "#005177"
        }
      ]
    },
    "layout": {
      "contentSize": "770px",
      "wideSize": "1100px"
    },
    "spacing": {
      "blockGap": true,
      "margin": true,
      "padding": true
    },
    "typography": {
      "fontSizes": [
        {
          "slug": "extra-small",
          "size": "1rem",
          "name": "Extra small"
        },
        {
          "slug": "small",
          "size": "1.125rem",
          "name": "Small"
        },
        {
          "slug": "medium",
          "size": "1.25rem",
          "name": "Medium"
        },
        {
          "slug": "large",
          "size": "1.5rem",
          "name": "Large"
        },
        {
          "slug": "extra-large",
          "size": "2.5rem",
          "name": "Extra large"
        }
      ],
      "lineHeight": true
    }
  },
  "styles": {
    "blocks": {
      "core/button": {
        "border": {
          "radius": "4px"
        }
      },
      "core/cover": {
        "spacing": {
          "blockGap":"var:preset|spacing|60"
        }
      },
      "core/group": {
        "spacing": {
          "padding": {
            "bottom": "var(--wp--preset--spacing--60)",
            "top": "var(--wp--preset--spacing--40)"
          }
        }
      }
    },
    "color": {
      "background": "#ffffff",
      "text": "#4a4a4a"
    },
    "typography": {
      "fontFamily": "Arial, Helvetica, sans-serif"
    }
  },
  "templateParts": [
    {
      "name": "site-header",
      "area": "header",
      "title": "Header"
    },
    {
      "name": "site-footer",
      "area": "footer",
      "title": "Footer"
    }
  ]
}